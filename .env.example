# Copy this file to .env (or export these as real environment variables) before running the app.
# Never commit a filled-in .env — it's already in .gitignore.

# --- Spring profile ---
# local  -> safe defaults for a laptop Postgres, see application-local.properties
# prod   -> everything below is required, nothing has a fallback
SPRING_PROFILES_ACTIVE=local

# --- Database (Postgres) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/ticketflow
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- JWT ---
# Generate real random values for anything beyond local dev, e.g.:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_HASH_KEY=replace-with-another-long-random-string

# --- Brevo (transactional email, free tier) ---
# Sign up at https://www.brevo.com, create an API key under SMTP & API settings.
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM_ADDRESS=noreply@livo.works
EMAIL_FROM_NAME=Livo

# Base URL of the FRONTEND (not this API) — used to build the "accept your offer" link in
# waitlist emails. That link opens a frontend route which calls this API's
# POST /waitlist/offers/{token}/accept on the customer's behalf (a plain email link can only
# ever produce a GET click, and that endpoint is a POST).
# Local dev: your frontend's dev server URL. Production: https://ticketflow-ebon.vercel.app
APP_BASE_URL=http://localhost:3000

# --- Business logic tuning ---
BOOKING_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
# how long a waitlist entry can sit WAITING before its request is given up on (see
# SYSTEM_DESIGN.md — protects against a request for more seats than will ever free up together)
WAITLIST_ACCUMULATION_TIMEOUT_MINUTES=60

# --- Bootstrap admin (created once on first startup if no admin exists) ---
ADMIN_EMAIL=admin@ticketflow.app
ADMIN_PASSWORD=ChangeMe123!
